<mxfile host="Electron">
  <diagram name="Página-1" id="P9FgATsp7UVTa7MawzZf">
    <mxGraphModel dx="2943" dy="2063" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    %% Clase Principal / Controladora\n    class SistemaBusNovaTech {\n        -String nombreTerminal\n        -ListaBuses buses\n        -GrafoRutero grafoRutas\n        -Usuario[] usuarios\n        -ServicioBCCR bccr\n        -GestorJSON gestorJSON\n        +iniciarSistema() void\n        +login(String user, String pass) boolean\n        +crearTiquete(Tiquete t) void\n        +procesarAbordaje(int idBus) void\n        +consultarTipoCambio() double\n    }\n\n    %% Servicios y Persistencia\n    class ServicioBCCR {\n        +obtenerTipoCambioDolar() double\n    }\n\n    class GestorJSON {\n        +guardarConfiguracion(String terminal, ListaBuses buses, Usuario[] usuarios) void\n        +cargarConfiguracion() boolean\n        +guardarTiquetes(ColaPrioridad colas) void\n        +guardarAtendidos(Tiquete tiquete, String terminal, int idBus) void\n        +guardarGrafo(GrafoRutero grafo) void\n    }\n\n    class Usuario {\n        -String username\n        -String password\n        +Usuario(String username, String password)\n        +autenticar(String pass) boolean\n        +getUsername() String\n    }\n\n    %% Estructura de Buses (Lista Enlazada)\n    class ListaBuses {\n        -NodoLista cabeza\n        -int tamano\n        +ListaBuses()\n        +agregarBus(Bus bus) void\n        +buscarBusPorId(int id) Bus\n        +obtenerBusColaMasCorta() Bus\n        +getTamano() int\n        +getCabeza() NodoLista\n    }\n\n    class NodoLista {\n        -Bus bus\n        -NodoLista siguiente\n        +NodoLista(Bus bus)\n        +getBus() Bus\n        +getSiguiente() NodoLista\n        +setSiguiente(NodoLista siguiente) void\n    }\n\n    class Bus {\n        -int idBus\n        -String tipoBus\n        -ColaPrioridad colaPasajeros\n        -Inspector inspector\n        +Bus(int idBus, String tipoBus, Inspector inspector)\n        +agregarTiquete(Tiquete t) void\n        +atenderSiguiente(String horaActual, String terminal, double tipoCambio) Tiquete\n        +getCantidadEnEspera() int\n        +getTipoBus() String\n        +getIdBus() int\n    }\n\n    class Inspector {\n        -String nombre\n        -boolean ocupado\n        +Inspector(String nombre)\n        +cobrarYAbordar(Tiquete tiquete, double tipoCambio) boolean\n        +isOcupado() boolean\n        +setOcupado(boolean ocupado) void\n    }\n\n    %% Estructura de Cola de Prioridad\n    class ColaPrioridad {\n        -NodoCola frente\n        -int tamano\n        +ColaPrioridad()\n        +encolar(Tiquete tiquete) void\n        +desencolar() Tiquete\n        +verFrente() Tiquete\n        +estaVacia() boolean\n        +getTamano() int\n    }\n\n    class NodoCola {\n        -Tiquete tiquete\n        -NodoCola siguiente\n        +NodoCola(Tiquete tiquete)\n        +getTiquete() Tiquete\n        +getSiguiente() NodoCola\n        +setSiguiente(NodoCola siguiente) void\n    }\n\n    %% Modelo de Datos\n    class Tiquete {\n        -String nombreCliente\n        -String idCliente\n        -int edad\n        -String monedaCuenta\n        -String horaCompra\n        -String horaAbordaje\n        -String tipoServicio\n        -String tipoBus\n        -double pesoCarga\n        +Tiquete(String nombre, String id, int edad, String moneda, String tipoServicio, String tipoBus, double pesoCarga)\n        +calcularCostoServicio(double tipoCambio) double\n        +marcarAtendido(String hora) void\n        +toJSON() String\n    }\n\n    %% Estructura de Grafos\n    class GrafoRutero {\n        -NodoGrafo cabeza\n        +GrafoRutero()\n        +agregarTerminal(String nombre) void\n        +agregarRuta(String origen, String destino, double peso) void\n        +calcularRutaMasCorta(String origen, String destino) String\n        +exportarJSON() String\n    }\n\n    class NodoGrafo {\n        -String nombreTerminal\n        -ListaAristas aristas\n        -NodoGrafo siguiente\n        +NodoGrafo(String nombreTerminal)\n    }\n\n    class Arista {\n        -String destino\n        -double distanciaPeso\n        -Arista siguiente\n        +Arista(String destino, double distanciaPeso)\n    }\n\n    %% Relaciones con Descripciones\n    SistemaBusNovaTech \&quot;1\&quot; --&gt; \&quot;1\&quot; ListaBuses : gestiona la flota\n    SistemaBusNovaTech \&quot;1\&quot; --&gt; \&quot;1\&quot; GrafoRutero : administra rutas\n    SistemaBusNovaTech \&quot;1\&quot; --&gt; \&quot;*\&quot; Usuario : autentica accesos\n    SistemaBusNovaTech \&quot;1\&quot; --&gt; \&quot;1\&quot; ServicioBCCR : consulta tipo de cambio\n    SistemaBusNovaTech \&quot;1\&quot; --&gt; \&quot;1\&quot; GestorJSON : persiste datos\n\n    ListaBuses \&quot;1\&quot; *-- \&quot;*\&quot; NodoLista : contiene nodos de\n    NodoLista \&quot;1\&quot; o-- \&quot;1\&quot; Bus : envuelve a\n\n    Bus \&quot;1\&quot; *-- \&quot;1\&quot; ColaPrioridad : mantiene cola de\n    Bus \&quot;1\&quot; *-- \&quot;1\&quot; Inspector : tiene asignado a\n\n    ColaPrioridad \&quot;1\&quot; *-- \&quot;*\&quot; NodoCola : contiene nodos de\n    NodoCola \&quot;1\&quot; o-- \&quot;1\&quot; Tiquete : guarda datos de\n\n    GrafoRutero \&quot;1\&quot; *-- \&quot;*\&quot; NodoGrafo : contiene vertices de\n    NodoGrafo \&quot;1\&quot; *-- \&quot;*\&quot; Arista : se conecta mediante\n\n    NodoLista \&quot;0..1\&quot; --&gt; \&quot;0..1\&quot; NodoLista : siguiente\n    NodoCola \&quot;0..1\&quot; --&gt; \&quot;0..1\&quot; NodoCola : siguiente\n    NodoGrafo \&quot;0..1\&quot; --&gt; \&quot;0..1\&quot; NodoGrafo : siguiente\n    Arista \&quot;0..1\&quot; --&gt; \&quot;0..1\&quot; Arista : siguiente\n\n    %% ESTILOS DE COLOR CLAROS Y ALTO CONTRASTE (Texto legible)\n    style SistemaBusNovaTech fill:#e0f2fe,stroke:#0284c7,stroke-width:3px,color:#0f172a\n    \n    style ListaBuses fill:#dbeafe,stroke:#2563eb,stroke-width:2px,color:#0f172a\n    style NodoLista fill:#dbeafe,stroke:#2563eb,stroke-width:2px,color:#0f172a\n    style ColaPrioridad fill:#dbeafe,stroke:#2563eb,stroke-width:2px,color:#0f172a\n    style NodoCola fill:#dbeafe,stroke:#2563eb,stroke-width:2px,color:#0f172a\n\n    style Bus fill:#dcfce7,stroke:#16a34a,stroke-width:2px,color:#0f172a\n    style Inspector fill:#dcfce7,stroke:#16a34a,stroke-width:2px,color:#0f172a\n    style Tiquete fill:#dcfce7,stroke:#16a34a,stroke-width:2px,color:#0f172a\n    style Usuario fill:#dcfce7,stroke:#16a34a,stroke-width:2px,color:#0f172a\n\n    style ServicioBCCR fill:#f3e8ff,stroke:#9333ea,stroke-width:2px,color:#0f172a\n    style GestorJSON fill:#ffedd5,stroke:#ea580c,stroke-width:2px,color:#0f172a\n\n    style GrafoRutero fill:#e0e7ff,stroke:#4f46e5,stroke-width:2px,color:#0f172a\n    style NodoGrafo fill:#e0e7ff,stroke:#4f46e5,stroke-width:2px,color:#0f172a\n    style Arista fill:#e0e7ff,stroke:#4f46e5,stroke-width:2px,color:#0f172a&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="iYAe__emYp5aNu0jSfdR-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
